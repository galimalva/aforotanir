---
// فایل: src/layouts/ProfileLayout.astro
const { lang } = Astro.props;

const content = {
  fa: {
    dir: 'rtl',
    htmlLang: 'fa',
    title: 'فروتن پور | نویسنده',
    btnTheme: 'تغییر تم سایت',
    name: 'علی فروتن پور لنگرودی',
    role: 'نویسنده',
    aboutTitle: 'درباره من',
    aboutText: 'پیش از این، با نوشتن فقط افکارم را روی کاغذ می‌آوردم، اما حالا با نوشتن زمان را به بازی می‌گیرم؛ زمانی که عصاره‌اش در قالب جوهر خودنویس روی سپیدی کاغذ می‌ریزد، خودش را کش می‌آورد، لم می‌دهد و برایم قیافه می‌گیرد.',
    bookIntroTitle: 'معرفی کتاب',
    bookTitle: 'عنوان کتاب شما',
    bookDesc: 'در اینجا می‌توانید خلاصه‌ای از داستان یا ایده اصلی کتاب خود را بنویسید. فضایی برای جذب مخاطب ایجاد کنید تا با خواندن این متن، تشنه خواندن کل کتاب شود. می‌توانید درباره فضای داستان، شخصیت‌های اصلی یا حس و حال کلی کتاب بنویسید.',
    btnBuy: 'خرید فیزیکی',
    btnDownload: 'دانلود PDF',
    langLink: '/en/',
    langText: 'English'
  },
  en: {
    dir: 'ltr',
    htmlLang: 'en',
    title: 'Forotan Pour | Author',
    btnTheme: 'Toggle Theme',
    name: 'Forotan Pour Langroudi',
    role: 'Author',
    aboutTitle: 'About Me',
    aboutText: 'Previously, by writing, I only put my thoughts on paper, but now by writing, I play with time; a time whose essence is poured in the form of fountain pen ink onto the whiteness of paper, stretching, breathing, and taking shape for me.',
    bookIntroTitle: 'Book Introduction',
    bookTitle: 'Your Book Title',
    bookDesc: 'Here you can write a summary of your story or the main idea of your book. Create a space to attract the audience so that by reading this text, they become eager to read the entire book. You can write about the setting, main characters, or the overall vibe of the book.',
    btnBuy: 'Physical Purchase',
    btnDownload: 'Download PDF',
    langLink: '/',
    langText: 'فارسی'
  }
};

const t = content[lang] || content.fa;
---

<html lang={t.htmlLang} dir={t.dir} data-theme="dark">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{t.title}</title>
        
        <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
        <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />
        
        <script is:inline>
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        </script>
    </head>
    <body>
        <!-- دکمه تغییر زبان -->
        <a href={t.langLink} class="lang-toggle" aria-label="Language Toggle">
            {t.langText}
        </a>

        <!-- دکمه تغییر تم -->
        <button id="theme-toggle" class="theme-toggle" aria-label={t.btnTheme}>
            <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>

        <div class="pattern-bg"></div>

        <main class="container">
            <div class="profile-card">
                <div class="profile-image-wrapper">
                    <img src="/author-photo.jpg" alt={t.name} class="profile-img" />
                </div>
                
                <h1 class="name">{t.name}</h1>
                <h2 class="title">{t.role}</h2>

                <div class="about-me">
                    <h3 class="section-title">{t.aboutTitle}</h3>
                    <p class="about-text">{t.aboutText}</p>
                </div>

                <div class="book-intro">
                    <h3 class="section-title">{t.bookIntroTitle}</h3>
                    <div class="book-content">
                        <div class="book-cover-wrapper">
                            <img src="/book-cover.jpg" alt={t.bookTitle} class="book-cover" />
                        </div>
                        <div class="book-details">
                            <h4 class="book-title">{t.bookTitle}</h4>
                            <p class="book-desc">{t.bookDesc}</p>
                        </div>
                    </div>
                </div>

                <div class="book-actions">
                    <a href="#" target="_blank" class="btn btn-primary">
                        <svg viewBox="0 0 24 24" class="btn-icon"><path d="M21 5c-1.11-.9-2.67-1.5-4.5-1.5-1.83 0-3.39.6-4.5 1.5-1.11-.9-2.67-1.5-4.5-1.5-1.83 0-3.39.6-4.5 1.5V22c1.11-.9 2.67-1.5 4.5-1.5 1.83 0 3.39.6 4.5 1.5 1.11-.9 2.67-1.5 4.5-1.5 1.83 0 3.39.6 4.5 1.5V5z"/></svg>
                        {t.btnBuy}
                    </a>
                    <a href="#" target="_blank" class="btn btn-secondary">
                        <svg viewBox="0 0 24 24" class="btn-icon"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
                        {t.btnDownload}
                    </a>
                </div>

                <div class="social-links">
                    <a href="mailto:ali.forotan.pour.langroudi@gmail.com" aria-label="Email" class="social-icon">
                        <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
                    </a>
                    <a href="https://t.me/RevayateVazheha" target="_blank" aria-label="Telegram" class="social-icon">
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.68a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.54-.37-.62-.2-1.12-.31-1.08-.64.02-.18.28-.36.78-.54 2.44-1.06 4.07-1.76 4.89-2.1.45-.17.8-.3 1.05-.4.46-.2.88-.27 1.16-.16.07.02.14.06.2.12.06.07.09.16.08.3z"/></svg>
                    </a>
                    <a href="https://www.instagram.com/forotanlangroudi" target="_blank" aria-label="Instagram" class="social-icon">
                        <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.817 1.713 4.965 4.965.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.248-1.718 4.817-4.965 4.965-1.265.058-1.645.069-4.849.069-3.204 0-3.584-.012-4.849-.069-3.26-.149-4.817-1.718-4.965-4.965-.058-1.265-.07-1.645-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.247 1.718-4.817 4.965-4.965 1.265-.058 1.644-.07 4.849-.07zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.272 2.695.072 7.053.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.277.058 1.686.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-10.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </a>
                </div>
            </div>
        </main>
    </body>
</html>

<script is:inline>
    const html = document.documentElement;
    const toggleBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('icon-sun');
    const moonIcon = document.getElementById('icon-moon');

    const updateIcons = (theme) => {
        if (theme === 'dark') {
            sunIcon.style.display = 'block';
            moonIcon.style.display = 'none';
        } else {
            sunIcon.style.display = 'none';
            moonIcon.style.display = 'block';
        }
    };

    const currentTheme = html.getAttribute('data-theme') || 'dark';
    updateIcons(currentTheme);

    toggleBtn.addEventListener('click', () => {
        const newTheme = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', newTheme);
        localStorage.setItem('theme', newTheme);
        updateIcons(newTheme);
    });
</script>

<style is:global>
    /* --- پالت رنگی حالت تاریک (پیش‌فرض) --- */
    :root {
        --bg-main: #142B4A;
        --text-main: #EDE5DD;
        --accent-color: #C5A065;
        --border-color: #1A3B3D;
        --text-muted: #8FA3A5;
        --card-bg: rgba(12, 25, 26, 0.85);
    }

    /* --- پالت رنگی حالت روشن --- */
    [data-theme="light"] {
        --bg-main: #F4F1ED; 
        --text-main: #142B4A; 
        --accent-color: #A68B4B; 
        --border-color: #D6D1CA; 
        --text-muted: #6B7B7C; 
        --card-bg: rgba(255, 255, 255, 0.7); 
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Vazirmatn', sans-serif;
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-main);
        min-height: 100vh;
        overflow-x: hidden;
        transition: background-color 0.4s ease, color 0.4s ease;
    }

    /* --- دکمه تغییر زبان --- */
    .lang-toggle {
        position: fixed;
        top: 20px;
        left: 20px;
        z-index: 100;
        height: 50px;
        padding: 0 20px;
        border-radius: 25px;
        border: 1px solid rgba(33, 150, 243, 0.4);
        background-color: rgba(33, 150, 243, 0.15);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 4px 15px rgba(33, 150, 243, 0.25), inset 0 0 10px rgba(33, 150, 243, 0.1);
        color: #2196F3;
        font-weight: 700;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .lang-toggle:hover {
        background-color: rgba(33, 150, 243, 0.3);
        box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4), inset 0 0 15px rgba(33, 150, 243, 0.2);
        transform: scale(1.05);
        color: #2196F3;
    }

    /* --- دکمه تغییر تم --- */
    .theme-toggle {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 100;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: 1px solid rgba(33, 150, 243, 0.4);
        background-color: rgba(33, 150, 243, 0.15);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 4px 15px rgba(33, 150, 243, 0.25), inset 0 0 10px rgba(33, 150, 243, 0.1);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2196F3;
        transition: all 0.3s ease;
    }

    .theme-toggle:hover {
        background-color: rgba(33, 150, 243, 0.3);
        box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4), inset 0 0 15px rgba(33, 150, 243, 0.2);
        transform: scale(1.05);
    }

    #icon-moon { display: none; }

    .pattern-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        background: 
            linear-gradient(90deg, var(--border-color) 1px, transparent 1px),
            linear-gradient(0deg, var(--border-color) 2px, transparent 2px),
            var(--bg-main);
        background-size: 80px 100%, 100% 200px;
        opacity: 0.3;
        transition: background 0.4s ease;
    }

    .container {
        max-width: 800px;
        margin: 40px auto;
        padding: 20px;
    }

    .profile-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 40px;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        text-align: center;
        transition: background 0.4s ease, border-color 0.4s ease;
    }

    .profile-image-wrapper {
        width: 150px;
        height: 150px;
        margin: 0 auto 20px;
        border-radius: 50%;
        border: 3px solid var(--accent-color);
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: border-color 0.4s ease;
    }

    .profile-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .name {
        font-size: 2.2rem;
        color: var(--text-main);
        margin-bottom: 8px;
        font-weight: 800;
    }

    .title {
        font-size: 1.2rem;
        color: var(--accent-color);
        font-weight: 400;
        letter-spacing: 1px;
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        transition: color 0.4s ease, border-color 0.4s ease;
    }

    .about-me {
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        text-align: center; 
        transition: border-color 0.4s ease;
    }

    .about-text {
        font-size: 1.05rem;
        line-height: 2;
        color: var(--text-muted);
        transition: color 0.4s ease;
        max-width: 600px;
        margin: 0 auto; 
    }

    .section-title {
        color: var(--text-main);
        font-size: 1.5rem;
        margin-bottom: 20px;
        text-align: center; 
    }

    .book-intro {
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        transition: border-color 0.4s ease;
    }

    .book-content {
        display: flex;
        flex-direction: row; 
        gap: 25px;
        align-items: center;
        text-align: right;
    }

    .book-cover-wrapper {
        flex-shrink: 0;
        width: 120px;
        height: 180px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        border: 1px solid var(--border-color);
        transition: border-color 0.4s ease, box-shadow 0.4s ease;
    }

    .book-cover {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .book-cover-wrapper:hover .book-cover {
        transform: scale(1.05); 
    }

    .book-details {
        flex-grow: 1;
    }

    .book-title {
        font-size: 1.4rem;
        color: var(--accent-color);
        margin-bottom: 12px;
        font-weight: 700;
        transition: color 0.4s ease;
    }

    .book-desc {
        font-size: 1rem;
        line-height: 1.9;
        color: var(--text-muted);
        text-align: justify;
        transition: color 0.4s ease;
    }

    .book-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        transition: border-color 0.4s ease;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 6px;
        font-family: 'Vazirmatn', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-icon {
        width: 18px;
        height: 18px;
        fill: currentColor;
    }

    .btn-primary {
        background-color: var(--text-main);
        color: var(--bg-main);
        border: 1px solid var(--text-main);
    }

    .btn-primary:hover {
        background-color: transparent;
        color: var(--text-main);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .btn-secondary {
        background-color: transparent;
        color: var(--text-main);
        border: 1px solid var(--text-main);
    }

    .btn-secondary:hover {
        background-color: var(--text-main);
        color: var(--bg-main);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .social-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 10px; 
        padding-top: 10px; 
    }

    .social-icon {
        color: var(--text-muted);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: transparent;
    }

    .social-icon:hover {
        color: #ffffff;
        background-color: #2196F3;
        transform: translateY(-3px);
        box-shadow: 0 4px 10px rgba(33, 150, 243, 0.4);
    }

    .social-icon svg {
        width: 20px;  
        height: 20px; 
        fill: currentColor;
    }

    @media (max-width: 600px) {
        .container {
            margin: 20px auto;
            padding: 15px;
        }
        .profile-card {
            padding: 25px;
        }
        .name {
            font-size: 1.8rem;
        }
        .book-actions {
            flex-direction: column;
        }
        .book-content {
            flex-direction: column;
            text-align: center;
        }
        .book-cover-wrapper {
            margin: 0 auto 20px; 
        }
        .book-desc {
            text-align: center;
        }
        .theme-toggle {
            top: 10px;
            right: 10px;
            width: 40px;
            height: 40px;
        }
        .lang-toggle {
            top: 10px;
            left: 10px;
            height: 40px;
            padding: 0 15px;
        }
    }
</style>