<!-- اسکریپت تغییر تم و زبان -->
<script is:inline>
    const html = document.documentElement;
    const toggleBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('icon-sun');
    const moonIcon = document.getElementById('icon-moon');
    const langToggle = document.getElementById('lang-toggle');
    const langText = document.getElementById('lang-text');

    // --- مدیریت تغییر تم ---
    const applyTheme = (theme) => {
        html.setAttribute('data-theme', theme);
        if (theme === 'dark') {
            sunIcon.style.display = 'block';
            moonIcon.style.display = 'none';
        } else {
            sunIcon.style.display = 'none';
            moonIcon.style.display = 'block';
        }
    };

    const savedTheme = localStorage.getItem('theme') || 'dark';
    applyTheme(savedTheme);

    toggleBtn.addEventListener('click', () => {
        const currentTheme = html.getAttribute('data-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(newTheme);
        localStorage.setItem('theme', newTheme);
    });

    // --- مدیریت تغییر زبان ---
    const applyLang = (lang) => {
        html.setAttribute('lang', lang);
        html.setAttribute('dir', lang === 'fa' ? 'rtl' : 'ltr');
        langText.textContent = lang === 'fa' ? 'EN' : 'FA';
        
        // تغییر متن‌ها
        document.querySelectorAll('[data-en]').forEach(el => {
            el.textContent = lang === 'fa' ? el.getAttribute('data-fa') : el.getAttribute('data-en');
        });
        
        // تغییر aria-label ها
        document.querySelectorAll('[data-en-aria]').forEach(el => {
            el.setAttribute('aria-label', lang === 'fa' ? el.getAttribute('data-fa-aria') : el.getAttribute('data-en-aria'));
        });
    };

    const savedLang = localStorage.getItem('lang') || 'fa';
    applyLang(savedLang);

    langToggle.addEventListener('click', () => {
        const currentLang = html.getAttribute('lang');
        const newLang = currentLang === 'fa' ? 'en' : 'fa';
        applyLang(newLang);
        localStorage.setItem('lang', newLang);
    });
</script>

<style is:global>
    /* --- پالت رنگی حالت تاریک (پیش‌فرض) --- */
    :root {
        --bg-main: #0C191A;
        --text-main: #EDE5DD;
        --accent-color: #C5A065;
        --border-color: #1A3B3D;
        --text-muted: #8FA3A5;
        --card-bg: rgba(12, 25, 26, 0.85);
    }

    /* --- پالت رنگی حالت روشن --- */
    [data-theme="light"] {
        --bg-main: #F4F1ED; 
        --text-main: #0C191A; 
        --accent-color: #A68B4B; 
        --border-color: #D6D1CA; 
        --text-muted: #6B7B7C; 
        --card-bg: rgba(255, 255, 255, 0.7); 
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Vazirmatn', sans-serif;
    }

    body {
        background-color: var(--bg-main);
        color: var(--text-main);
        min-height: 100vh;
        overflow-x: hidden;
        transition: background-color 0.4s ease, color 0.4s ease;
    }

    /* مخفی کردن نوار ابزار Astro */
    astro-dev-toolbar {
        display: none !important;
    }

    /* --- استایل دکمه‌های شناور --- */
    .theme-toggle, .lang-toggle {
        position: fixed;
        top: 20px;
        z-index: 100;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: 1px solid rgba(33, 150, 243, 0.4);
        background-color: rgba(33, 150, 243, 0.15);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        box-shadow: 0 4px 15px rgba(33, 150, 243, 0.25), inset 0 0 10px rgba(33, 150, 243, 0.1);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2196F3;
        transition: all 0.3s ease;
    }

    .theme-toggle {
        left: 20px; /* چپ در LTR، راست در RTL (با منطق فیزیکی) */
    }

    .lang-toggle {
        left: 80px; /* کنار دکمه تم */
        font-weight: 700;
        font-size: 0.9rem;
    }

    .theme-toggle:hover, .lang-toggle:hover {
        background-color: rgba(33, 150, 243, 0.3);
        box-shadow: 0 6px 20px rgba(33, 150, 243, 0.4), inset 0 0 15px rgba(33, 150, 243, 0.2);
        transform: scale(1.05);
    }

    #icon-moon {
        display: none;
    }

    .pattern-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        background: 
            linear-gradient(90deg, var(--border-color) 1px, transparent 1px),
            linear-gradient(0deg, var(--border-color) 2px, transparent 2px),
            var(--bg-main);
        background-size: 80px 100%, 100% 200px;
        opacity: 0.3;
        transition: background 0.4s ease;
    }

    .container {
        max-width: 800px;
        margin: 40px auto;
        padding: 20px;
    }

    .profile-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 40px;
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        text-align: center;
        transition: background 0.4s ease, border-color 0.4s ease;
    }

    .profile-image-wrapper {
        width: 150px;
        height: 150px;
        margin: 0 auto 20px;
        border-radius: 50%;
        border: 3px solid var(--accent-color);
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: border-color 0.4s ease;
    }

    .profile-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .name {
        font-size: 2.2rem;
        color: var(--text-main);
        margin-bottom: 8px;
        font-weight: 800;
    }

    .title {
        font-size: 1.2rem;
        color: var(--accent-color);
        font-weight: 400;
        letter-spacing: 1px;
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        transition: color 0.4s ease, border-color 0.4s ease;
    }

    .about-me {
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        text-align: justify;
        transition: border-color 0.4s ease;
    }

    .about-text {
        font-size: 1.05rem;
        line-height: 2;
        color: var(--text-muted);
        transition: color 0.4s ease;
    }

    .section-title {
        color: var(--text-main);
        font-size: 1.5rem;
        margin-bottom: 15px;
        text-align: start; /* تراز خودکار با جهت متن */
    }

    /* --- استایل بخش معرفی کتاب --- */
    .book-showcase {
        display: flex;
        gap: 30px;
        margin-bottom: 40px;
        padding-bottom: 30px;
        border-bottom: 1px solid var(--border-color);
        text-align: start;
        align-items: center;
        transition: border-color 0.4s ease;
    }

    .book-cover-wrapper {
        flex: 0 0 140px;
        max-width: 140px;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        aspect-ratio: 2/3;
        transition: transform 0.3s ease;
    }

    .book-cover-wrapper:hover {
        transform: translateY(-5px) scale(1.02);
    }

    .book-cover {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .book-info {
        flex: 1;
    }

    .book-title {
        font-size: 1.4rem;
        color: var(--accent-color);
        margin-bottom: 12px;
        font-weight: 700;
    }

    .book-description {
        font-size: 0.95rem;
        line-height: 1.8;
        color: var(--text-muted);
        margin-bottom: 20px;
        text-align: justify;
    }

    /* --- استایل دکمه‌های کتاب --- */
    .book-actions {
        display: flex;
        justify-content: flex-start;
        gap: 12px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 8px 16px;
        border-radius: 6px;
        font-family: 'Vazirmatn', sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        cursor: pointer;
    }

    .btn-icon {
        width: 18px;
        height: 18px;
        fill: currentColor;
    }

    .btn-primary {
        background-color: var(--text-main);
        color: var(--bg-main);
        border: 1px solid var(--text-main);
    }

    .btn-primary:hover {
        background-color: transparent;
        color: var(--text-main);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .btn-secondary {
        background-color: transparent;
        color: var(--text-main);
        border: 1px solid var(--text-main);
    }

    .btn-secondary:hover {
        background-color: var(--text-main);
        color: var(--bg-main);
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    /* --- استایل شبکه‌های اجتماعی --- */
    .social-links {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin-top: 10px; 
        padding-top: 10px; 
    }

    .social-icon {
        color: var(--text-muted);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background-color: transparent;
    }

    .social-icon:hover {
        color: #ffffff;
        background-color: #2196F3;
        transform: translateY(-3px);
        box-shadow: 0 4px 10px rgba(33, 150, 243, 0.4);
    }

    .social-icon svg {
        width: 20px;  
        height: 20px; 
        fill: currentColor;
    }

    /* ریسپانسیو برای موبایل */
    @media (max-width: 600px) {
        .container {
            margin: 20px auto;
            padding: 15px;
        }
        .profile-card {
            padding: 25px;
        }
        .name {
            font-size: 1.8rem;
        }
        
        .book-showcase {
            flex-direction: column;
            text-align: center;
            align-items: center;
        }
        .book-cover-wrapper {
            flex: none;
            width: 160px;
            max-width: 100%;
            margin-bottom: 20px;
        }
        .section-title, .book-title {
            text-align: center;
        }
        .book-info {
            width: 100%;
        }
        .book-actions {
            justify-content: center;
        }
        
        .theme-toggle {
            top: 10px;
            left: 10px;
            width: 40px;
            height: 40px;
        }
        .lang-toggle {
            top: 10px;
            left: 60px;
            width: 40px;
            height: 40px;
            font-size: 0.8rem;
        }
    }
</style>